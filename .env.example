# GHub Marketplace — Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit .env — only .env.example goes into version control.
# ALL values here are CLIENT-SIDE SAFE (browser-visible by design).
# ─────────────────────────────────────────────────────────────────────────────

# ── API & Socket ──────────────────────────────────────────────────────────────
# Your backend API base URL (no trailing slash)
# Production example: https://api.yourdomain.com/api
REACT_APP_API_URL=http://localhost:4000/api

# WebSocket server URL (usually same host as API without /api path)
# Production example: https://api.yourdomain.com
REACT_APP_SOCKET_URL=http://localhost:4000

# ── Supabase (public/browser-safe keys only) ──────────────────────────────────
# Supabase project URL
REACT_APP_SUPABASE_URL=https://your-project.supabase.co

# Supabase PUBLISHABLE key (anon/public — safe for browser)
# NEVER use the service_role key here
REACT_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# ── Firebase Web (all values are browser-safe) ────────────────────────────────
REACT_APP_FIREBASE_API_KEY=your_firebase_web_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-firebase-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_web_app_id
REACT_APP_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# ── Midtrans (CLIENT KEY only — safe for browser) ─────────────────────────────
# Set to true for production, false for sandbox
REACT_APP_MIDTRANS_IS_PRODUCTION=false
# Only the CLIENT/PUBLIC key — NEVER the Server Key
REACT_APP_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx

# ── CRA Dev settings (not needed in production) ───────────────────────────────
# CHOKIDAR_USEPOLLING=true
# FAST_REFRESH=true
# BROWSER=none
